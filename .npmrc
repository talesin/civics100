# Required by apps/mobile: @tamagui/animations-css@1.144.4 transitively pulls
# react-dom@19.2.7 (peers react@^19.2.7), which conflicts with the Expo SDK 56 pinned
# react@19.2.3. react-dom is web-only and irrelevant to the native bundle, so we relax
# strict peer resolution repo-wide. Without this, a plain `npm install` ERESOLVE-fails.
# (Phase-0 carry-forward #2.) NOTE: this disables npm's automatic peer installation, so
# any peer a workspace actually needs must be declared as a direct dependency.
legacy-peer-deps=true
