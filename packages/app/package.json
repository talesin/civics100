{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "description": "Shared Tamagui UI and config consumed by website (Next.js) and apps/mobile (Expo)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tamagui.config": {
      "types": "./src/tamagui.config.ts",
      "import": "./src/tamagui.config.ts",
      "default": "./src/tamagui.config.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./components/tamagui": {
      "types": "./src/components/tamagui/index.ts",
      "import": "./src/components/tamagui/index.ts",
      "default": "./src/components/tamagui/index.ts"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "import": "./src/services/index.ts",
      "default": "./src/services/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "import": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./screens": {
      "types": "./src/screens/index.ts",
      "import": "./src/screens/index.ts",
      "default": "./src/screens/index.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf node_modules/ coverage/",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "list-todos": "find src/ -iname '*.ts' -o -iname '*.tsx' | xargs grep --color -inHE '(TODO|FIXME|HACK)' || true"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "@tamagui/animations-css": "1.144.4",
    "@tamagui/animations-moti": "1.144.4",
    "@tamagui/lucide-icons": "1.144.4",
    "civics2json": "*",
    "effect": "^3.19.19",
    "expo-audio": "*",
    "expo-haptics": "*",
    "expo-speech": "*",
    "lucide-react": "*",
    "questionnaire": "*",
    "react": "*",
    "react-native": "*",
    "tamagui": "1.144.4"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@tamagui/lucide-icons": {
      "optional": true
    },
    "expo-audio": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "expo-speech": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.25.1",
    "@jest/globals": "^29.7.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tamagui/animations-css": "1.144.4",
    "@tamagui/animations-moti": "1.144.4",
    "@tamagui/lucide-icons": "1.144.4",
    "@types/react": "^19.2.14",
    "lucide-react": "^1.14.0",
    "civics2json": "*",
    "effect": "^3.19.19",
    "questionnaire": "*",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-native": "0.85.3",
    "tamagui": "1.144.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "expo-audio": "56.0.13",
    "expo-haptics": "56.0.3",
    "expo-speech": "56.0.3"
  }
}
